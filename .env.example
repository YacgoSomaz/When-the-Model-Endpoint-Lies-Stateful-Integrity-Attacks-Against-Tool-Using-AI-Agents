# Required: an OpenAI-compatible Chat Completions endpoint.
LAB_GATEWAY_URL=https://api.deepseek.com/chat/completions

# Loopback-only by default. Do not use 0.0.0.0 without a security review.
LAB_BIND_HOST=127.0.0.1
LAB_PORT=8001

# Required if the console is reachable by anyone other than the local researcher.
LOG_VIEWER_USER=researcher
LOG_VIEWER_PASSWORD=replace-with-a-long-random-password

# Set exactly to CONTROLLED_RESEARCH_ONLY to enable interception routes.
LAB_ACKNOWLEDGEMENT=CONTROLLED_RESEARCH_ONLY
