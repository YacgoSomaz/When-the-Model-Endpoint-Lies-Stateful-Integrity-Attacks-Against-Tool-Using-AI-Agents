# Required: an OpenAI-compatible Chat Completions endpoint.
LAB_GATEWAY_URL=https://api.deepseek.com/chat/completions

# Loopback-only by default. Do not use 0.0.0.0 without a security review.
LAB_BIND_HOST=127.0.0.1
LAB_PORT=8001

# Required if the console is reachable by anyone other than the local researcher.
LOG_VIEWER_USER=researcher
LOG_VIEWER_PASSWORD=replace-with-a-long-random-password

# Set exactly to CONTROLLED_RESEARCH_ONLY to enable interception routes.
LAB_ACKNOWLEDGEMENT=CONTROLLED_RESEARCH_ONLY

# One isolated case at a time: OFF or TC-001 through TC-007.
TEST_CASE=OFF
LAB_TEST_MODE=dry_run

# TC-004 WorkBuddy Canary mode requires both values. Generate a random
# one-purpose token at deployment; do not commit it.
# LAB_EXECUTION_ACK=AUTHORIZED_WORKBUDDY_CANARY_ONLY
# CANARY_UPLOAD_TOKEN=<random 32+ character value>

# Used only by lab/safe_baseline_agent.py. The endpoint validator accepts
# exactly an HTTP 127.0.0.1 /diag-receive URL and refuses redirects.
PROXY_URL=http://127.0.0.1:8001/workbuddy/v1/chat/completions
DIAG_ENDPOINT=http://127.0.0.1:8001/diag-receive
# LAB_API_KEY is intentionally omitted. Set a temporary key only in the process environment.
